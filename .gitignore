# ---------------------------------------------------------------------------
# Secrets and environment
# ---------------------------------------------------------------------------
# These carry LDAP service-account credentials, the JWT signing key, the
# Solutions API token and the SSD login password. Never commit them.
.env
.env.*
*.env
*.env_bkp
.env_bkp

# Any .env kept aside under a suffix -- .env_prod, .env_local, .env_old. These
# are the ones that bite: renaming .env to .env_prod moves a live SECRET_KEY out
# from under the patterns above and into `git add -A`. Matches the underscore
# form only, so .env.example below is unaffected.
.env_*

# Templates carry key names only, never values, and are meant to be committed.
!.env.example
!**/.env.example

# BuildKit secret file holding the authenticated build proxy URL. Written just
# before `docker build --secret` and deleted after; never committed.
.build-proxy
**/.build-proxy

# Runtime config written by the Settings screen — app/environment.json holds
# SOLUTIONS_API_AUTH_TOKEN, app/config.json holds the live AI endpoint config.
#ai-admin-module-py/app/config.json
#ai-admin-module-py/app/environment.json

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
# admin.db contains real user rows. The -wal/-shm sidecars appear once WAL
# journal mode is enabled (see app/database/connection.py).
#*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv*/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
dist/
dist.zip
dist-org.zip
dist.tar
dist.tar.gz
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Automation Module — generated test assets and run evidence
# ---------------------------------------------------------------------------
# Materialised workspaces, generated specs and captured artifacts are run
# output, not source. Regenerated on every run; large and non-reviewable.
#storage/
#ai-admin-module-py/storage/
#automation_workspace/
#playwright-report/
#test-results/
*.webm
*.zip.part

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
