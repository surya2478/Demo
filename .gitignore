# ---------------------------------------------------------------------------
# Secrets and environment
# ---------------------------------------------------------------------------
# These carry LDAP service-account credentials, the JWT signing key, the
# Solutions API token and the SSD login password. Never commit them.
.env
.env.*
*.env
*.env_bkp
.env_bkp

# Any .env kept aside under a suffix -- .env_prod, .env_local, .env_old. These
# are the ones that bite: renaming .env to .env_prod moves a live SECRET_KEY out
# from under the patterns above and into `git add -A`. Matches the underscore
# form only, so .env.example below is unaffected.
.env_*

# Templates carry key names only, never values, and are meant to be committed.
!.env.example
!**/.env.example

# BuildKit secret file holding the authenticated build proxy URL. Written just
# before `docker build --secret` and deleted after; never committed.
.build-proxy
**/.build-proxy

# Runtime config written by the Settings screen — app/environment.json holds
# SOLUTIONS_API_AUTH_TOKEN, app/config.json holds the live AI endpoint config.
#
# Both are PER-ENVIRONMENT and must not be committed. config.json in particular
# decides where the Test Assistant sends its requests: a developer's copy names
# a localhost backend, and committing that carries local routing into every
# other deployment. Neither file needs to ship -- routers/settings.py writes a
# fresh one from the defaults in app/config.py on the first read, and those
# defaults are the production values. See app/config.json.example.
ai-admin-module-py/app/config.json
ai-admin-module-py/app/environment.json

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
# admin.db contains real user rows, and local authentication stores their
# passwords in cleartext -- so a committed database is a committed credential
# list. Both tracked copies were removed from the index; they remain on disk
# and are runtime state, not source.
#
# A fresh deployment does not need one: SQLite creates the file, init_db
# creates the tables, and app/seed.py provides the starting accounts. The
# database under db-backup/ is the live one and belongs to the server that
# runs it -- back it up there, not here.
#
# The -wal/-shm sidecars appear once WAL journal mode is enabled (see
# app/database/connection.py).
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv*/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
dist/
# Kept-aside copies of earlier builds: dist_bkp, dist_new, dist_04_09 ...
dist_*/
dist.zip
dist-org.zip
dist.tar
dist.tar.gz
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Automation Module — generated test assets and run evidence
# ---------------------------------------------------------------------------
# Materialised workspaces, generated specs and captured artifacts are run
# output, not source. Regenerated on every run; large and non-reviewable.
ai-admin-module-py/storage/
#automation_workspace/
#playwright-report/
#test-results/
*.webm
*.zip.part
*.zip

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
