# ---------------------------------------------------------------------------
# AI-Testing admin backend -- environment template
# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; this file is committed, so it
# must never contain real values.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_ENV=dev
DATABASE_URL=sqlite:///./admin.db

# JWT signing key. Generate one per environment, never share across them:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Tokens issued with an empty key are not usable.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Comma-separated origins allowed to call this API from a browser.
CORS_ALLOW_ORIGINS=http://localhost:5175

# --- LDAP / Active Directory -------------------------------------------------
# Required for users whose auth_source is 'ldap'. Local-auth users are
# unaffected and sign in without any of these set.
#
# If any of the four required keys is blank, LDAP authentication fails with a
# message naming the missing key rather than attempting a bind.

# Directory endpoint, including scheme and port.
#   e.g. ldaps://<ad-host>:636
LDAP_SERVER_URL=

# Where user searches begin. Usually the domain root.
#   e.g. DC=example,DC=corp,DC=ae
LDAP_SEARCH_BASE=

# Distinguished name of the service account used to bind and search.
#   e.g. cn=<svc-account>,OU=<ou>,DC=example,DC=corp,DC=ae
LDAP_SERVICE_ACCOUNT_DN=

# Password for that service account. Secret -- never commit a real value.
LDAP_SERVICE_ACCOUNT_PASSWORD=

# Lookup pattern. The default suits Active Directory; override only for a
# directory that keys users differently (e.g. "(uid={username})" for OpenLDAP).
# LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})

# Developer-only escape hatch. When true, a directory that cannot be reached
# causes LDAP logins to accept one shared literal password instead of failing.
# Leave false everywhere except a local machine with no directory available --
# enabling it in a shared environment removes authentication for every
# LDAP-whitelisted user.
LDAP_ALLOW_DEMO_FALLBACK=false

# --- Cookies -----------------------------------------------------------------
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# --- External services -------------------------------------------------------
SOLUTIONS_API_BASE_URL=
SOLUTIONS_API_TIMEOUT_SECONDS=60
# Written by the Settings screen into app/environment.json at runtime; set here
# only to seed a fresh deployment.
SOLUTIONS_API_AUTH_TOKEN=

# Path to a CA bundle when the OSLC/Jazz endpoint uses a private CA.
# OSLC_CA_BUNDLE_PATH=

# --- Automation Module -------------------------------------------------------
# Master switch. When false the routes stay mounted but refuse, so the UI can
# explain why instead of failing opaquely.
AUTOMATION_ENABLED=true

# Root for run workspaces, generated specs and evidence (screenshot, video,
# trace). Regenerable output -- gitignored, safe to delete between runs.
AUTOMATION_STORAGE_PATH=./storage/automation

# How to invoke the Node toolchain. "npx" works when Node 20 is on PATH; use an
# absolute path when the backend runs under a service account with a different
# PATH than your shell.
AUTOMATION_NODE_PATH=npx

# Wall clock per run before the subprocess is killed and the run recorded as
# timed out.
AUTOMATION_RUN_TIMEOUT_SECONDS=600

# Browser runs are memory-hungry and this backend is a single process, so 1 is
# the safe default.
AUTOMATION_MAX_CONCURRENT_RUNS=1
