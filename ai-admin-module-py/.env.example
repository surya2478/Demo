# ---------------------------------------------------------------------------
# AI-Testing admin backend -- environment template
# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; this file is committed, so it
# must never contain real values.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_ENV=dev
DATABASE_URL=sqlite:///./admin.db

# JWT signing key. Generate one per environment, never share across them:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Tokens issued with an empty key are not usable.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Comma-separated origins allowed to call this API from a browser.
CORS_ALLOW_ORIGINS=http://localhost:5175

# --- LDAP / Active Directory -------------------------------------------------
# Required for users whose auth_source is 'ldap'. Local-auth users are
# unaffected and sign in without any of these set.
#
# If any of the four required keys is blank, LDAP authentication fails with a
# message naming the missing key rather than attempting a bind.

# Directory endpoint, including scheme and port.
#   e.g. ldaps://<ad-host>:636
LDAP_SERVER_URL=

# Where user searches begin. Usually the domain root.
#   e.g. DC=example,DC=corp,DC=ae
LDAP_SEARCH_BASE=

# Distinguished name of the service account used to bind and search.
#   e.g. cn=<svc-account>,OU=<ou>,DC=example,DC=corp,DC=ae
LDAP_SERVICE_ACCOUNT_DN=

# Password for that service account. Secret -- never commit a real value.
LDAP_SERVICE_ACCOUNT_PASSWORD=

# Lookup pattern. The default suits Active Directory; override only for a
# directory that keys users differently (e.g. "(uid={username})" for OpenLDAP).
# LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})

# Developer-only escape hatch. When true, a directory that cannot be reached
# causes LDAP logins to accept one shared literal password instead of failing.
# Leave false everywhere except a local machine with no directory available --
# enabling it in a shared environment removes authentication for every
# LDAP-whitelisted user.
LDAP_ALLOW_DEMO_FALLBACK=false

# --- Cookies -----------------------------------------------------------------
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# --- External services -------------------------------------------------------
SOLUTIONS_API_BASE_URL=
SOLUTIONS_API_TIMEOUT_SECONDS=60
# Written by the Settings screen into app/environment.json at runtime; set here
# only to seed a fresh deployment.
SOLUTIONS_API_AUTH_TOKEN=

# Path to a CA bundle when the OSLC/Jazz endpoint uses a private CA.
# OSLC_CA_BUNDLE_PATH=

# --- Automation Module -------------------------------------------------------
# Master switch. When false the routes stay mounted but refuse, so the UI can
# explain why instead of failing opaquely.
AUTOMATION_ENABLED=true

# Root for run workspaces, generated specs and evidence (screenshot, video,
# trace). Regenerable output -- gitignored, safe to delete between runs.
AUTOMATION_STORAGE_PATH=./storage/automation

# How to invoke the Node toolchain. "npx" works when Node 20 is on PATH; use an
# absolute path when the backend runs under a service account with a different
# PATH than your shell.
AUTOMATION_NODE_PATH=npx

# Wall clock per run before the subprocess is killed and the run recorded as
# timed out.
AUTOMATION_RUN_TIMEOUT_SECONDS=600

# Browser runs are memory-hungry and this backend is a single process, so 1 is
# the safe default.
AUTOMATION_MAX_CONCURRENT_RUNS=1

# Directory containing the Knowledge Base's "applications/" folder.
#
# Leave empty to use the copy baked into the image at /app/knowledge_base --
# that is the normal state, and what a plain deployment does.
#
# Set it only to override the baked-in copy with a bind-mounted directory, so
# flow blueprints can be updated without rebuilding the image. Point it at the
# PARENT of "applications", not at "applications" itself:
#     AUTOMATION_KB_PATH=/app/external-kb
# AUTOMATION_KB_PATH=

# --- LLM provider ------------------------------------------------------------
# Which backend the Studio's own LLM work (test-case refinement, script
# generation, healing, Knowledge Base synthesis) talks to.
#
#   ai_service  the AI service at ai_config.BASE_URL owns the model and its
#               credentials; this backend holds no key. It is told WHICH model
#               to use by ai_config.PARAMETERS -- the same configuration the
#               Test Assistant tabs send and the Settings screen edits -- so
#               both modules run on one configuration.
#   openrouter  this backend calls OpenRouter directly, using the key below,
#               and ai_config.PARAMETERS is ignored (the model is chosen
#               server-side; see services/generation/stream.py).
#
# ENTERPRISE / PRODUCTION: leave this as ai_service and leave every
# OPENROUTER_* value below empty. Combined with an un-repointed
# ai_config.BASE_URL, the Test Assistant tabs go straight to the external AI
# service and the Automation module follows them there. That is the shipped
# default and needs no further configuration.
LLM_PROVIDER=ai_service

# Wall clock for one ai_service call, in seconds.
AI_SERVICE_TIMEOUT_SECONDS=120

# --- OpenRouter --------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY. Read only when LLM_PROVIDER=openrouter; every value
# here should stay empty in an enterprise deployment.
#
# Two independent switches have to be thrown for OpenRouter to serve anything,
# and BOTH are deliberate:
#
#   1. LLM_PROVIDER=openrouter routes the Automation module here.
#   2. OPENROUTER_MODEL, when set, arms /generate/* for the Test Assistant.
#      Left empty, those routes stay mounted but refuse with a 502 naming this
#      setting -- so an unset model is the production kill switch, and the
#      endpoints cannot quietly start billing.
#
# Repointing ai_config.BASE_URL (or ENDPOINTS.generateTestCasesUrl) at this
# backend is the third, separate step that sends the Test Assistant here at
# all. Do not do it in an enterprise deployment.
#
# THE KEY BELONGS HERE, SERVER-SIDE, AND NOWHERE ELSE. Do not put it in
# app/config.json (ai_config), the Settings screen, or a VITE_ variable:
#
#   * GET /settings/ai-config serves ai_config to every authenticated user and
#     the frontend caches it in localStorage.
#   * VITE_ values are inlined into the JavaScript bundle at build time.
#
# Either one publishes the key to every user of the app and to anyone who can
# read the bundle. Rotate immediately if it has been committed or shipped.
#
# Create a key at https://openrouter.ai/keys -- secret, never commit a real one.
OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# A "vendor/model" slug from https://openrouter.ai/models -- no default,
# because guessing one would silently bill a model nobody chose. See the kill
# switch note above before setting this anywhere but a developer machine.
OPENROUTER_MODEL=

OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_TOKENS=8192

# Low on purpose: this generates scripts and structured JSON, where a
# reproducible answer matters more than a varied one.
OPENROUTER_TEMPERATURE=0.1

# Optional attribution, sent as HTTP-Referer and X-Title. OpenRouter uses these
# to identify the calling app; both are safe to leave empty.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI Test Automation Studio
