    },
    {
      "step_number": 5,
      "action": "Select {{plan_name}} and review plan allowances & promo pricing",
      "target": ".plan-card:has-text('{{plan_name}}'), div:has-text('{{plan_name}}')",
      "expected_result": "Plan details show discounted rate, local data, local minutes, international minutes, CUG minutes, and flexi SMS"
    },
    {
      "step_number": 6,
      "action": "Click 'Buy Now' on {{plan_name}}",
      "target": "a[href*='ratePlanId={{rate_plan_id}}'], a:has-text('Buy Now')",
      "expected_result": "User is redirected to B2B Ordering verification page"
    },
    {
      "step_number": 7,
      "action": "Verify B2B Ordering Email Verification Page",
      "target": "/b2bportal/ordering-email-verification.html",
      "expected_result": "Online ordering email verification screen is displayed with matching plan parameters"
    }
  ],
