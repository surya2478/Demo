{
  "app_id": "eand_ae",
  "app_name": "e& UAE Web Portal",
  "base_url": "https://www.eand.ae/en/index.html",
  "domain": "eand.ae",
  "framework": "Angular SPA",
  "security_profile": {
    "waf_provider": "Akamai",
    "rate_limit_policy": {
      "min_inter_step_delay_ms": 1500,
      "navigation_timeout_ms": 45000
    },
    "cookie_overlay": {
      "type": "shadow_dom",
      "host_selector": "#usercentrics-root",
      "dismissal_code": "document.querySelector('#usercentrics-root')?.remove(); document.body.style.overflow = 'auto';"
    }
  },
  "default_viewport": {
    "width": 1440,
    "height": 900
  },
  "search_mechanism": {
    "trigger_selector": ".search-wrap-dekstop, button[aria-label*='search' i], .search-btn",
    "popup_container": "#searchPopup",
    "input_selector": "input[type='search'], input[placeholder*='Search' i], #search-input"
  },
  "endpoints": {
    "cart": "/eshop/checkout/cart"
  },
  "url_templates": {
    "product_configuration": "/eshop/devices/configuration?productId={product_id}&skuId={sku_id}&catName={category}&listVal=Smartphones&showDefault=true",
    "catalog_link_locator": "a[href*='{category_slug}']"
  },
  "selectors": {
    "navigation_header": "header, .header-container, nav.main-nav",
    "catalog": {
      "product_cards": ".device-card, .product-tile, .eshop-product-card",
      "filter_tabs": ".filter-container, .brand-filter, .category-filter",
      "sort_dropdown": "select[name='sort'], .sort-by"
    },
    "product_configuration": {
      "storage_selector": ".device-variant-options, .storage-btn, label:has-text('GB'), [role='radio']:has-text('GB')",
      "color_selector": ".color-swatch, .color-btn, [role='radio']:has-text('Titanium'), [role='radio']:has-text('Black')",
      "payment_plan_tabs": ".segment-tab, [role='radio']:has-text('One time'), button:has-text('One time'), button:has-text('Smart Pay')",
      "add_to_cart_cta": "button:has-text('ADD TO CART'), button:has-text('Checkout Now')",
      "price_display": ".price-container, .total-price, .device-price"
    },
    "cart": {
      "cart_summary": ".cart-summary, .order-review-container",
      "item_title": ".cart-item-title, .product-name",
      "payment_breakdown": ".cart-payment-type, .installment-term",
      "proceed_to_checkout_cta": "button:has-text('Checkout Now'), button:has-text('Proceed to Checkout')"
    }
  },
  "default_flow_id": "flow_smartphones_purchase",
  "default_payment_plan": "One time",
  "default_automation_boundary": {
    "automated_scope": "Catalog -> Product Configuration -> Plan Selection -> Add to Cart -> Cart Verification",
    "external_boundary": "Live Payment Gateway (Credit Card / OTP) is an external boundary."
  },
  "product_name_stopwords": [
    "apple",
    "samsung",
    "huawei",
    "marshall",
    "honor"
  ],
  "step_grounding_rules": [
    {
      "id": "portal_homepage",
      "first_step_only": true,
      "keywords": [
        "homepage",
        "index.html",
        "portal"
      ],
      "target": "{base_route}"
    },
    {
      "id": "cookie_overlay",
      "keywords": [
        "cookie",
        "privacy",
        "overlay",
        "banner",
        "usercentrics"
      ],
      "target": "{cookie_host_selector}"
    },
    {
      "id": "product_configuration",
      "keywords": [
        "product configuration",
        "configure",
        "open product",
        "select product",
        "select the",
        "choose the",
        "item configuration",
        "view details"
      ],
      "match_known_products": true,
      "target": "{product_configuration_route}"
    },
    {
      "id": "catalog_listing",
      "keywords": [
        "catalog",
        "listing",
        "devices ->",
        "accessories ->",
        "browse devices",
        "browse catalog",
        "category page"
      ],
      "target": "{catalog_route}"
    },
    {
      "id": "variant_and_payment",
      "keywords": [
        "one time",
        "full price",
        "payment option",
        "variant",
        "storage",
        "color",
        "smart pay",
        "installment"
      ],
      "target": ".segment-tab:has-text('One time'), label:has-text('One Time')"
    },
    {
      "id": "add_to_cart",
      "keywords": [
        "add to cart",
        "add to basket"
      ],
      "target": "button:has-text('ADD TO CART'), button:has-text('Checkout Now')"
    },
    {
      "id": "cart_review",
      "keywords": [
        "shopping cart",
        "cart review",
        "cart screen",
        "checkout review",
        "cart page",
        "verify cart",
        "verify shopping cart",
        "secure checkout"
      ],
      "target": "{cart_route}"
    },
    {
      "id": "proceed_to_checkout",
      "keywords": [
        "checkout",
        "proceed to checkout",
        "proceed to"
      ],
      "target": "button:has-text('Checkout Now'), button:has-text('Proceed to Checkout')"
    }
  ],
  "generation_directives": [
    "1. PRECONDITIONS: Must state that the user is on '{app_name}' ({base_url}) with the cookie banner dismissed.",
    "2. TEST STEPS: Every generated test case MUST include the real URLs directly in the step actions:",
    "   - Include navigation to the portal ({base_url}) and the catalog route ({catalog_entrypoint}).",
    "   - When opening the product configuration, ALWAYS include the exact Direct Configuration URL of the form {product_configuration_url_template}.",
    "   - Include variant selection, stock detection, Add to Cart, and cart verification ({cart_endpoint}).",
    "3. TEST DATA: Must explicitly include the 'ProductId: <id>' and 'SkuId: <id>' parameters along with the chosen Storage, Color, and Payment option from the Knowledge Base so downstream automated execution can parse them."
  ],
  "test_case_matrix": [
    "Positive path: Happy-path purchase with One Time payment.",
    "Installment path: Purchase with Smart Pay installment plan.",
    "Variant validations: Storage and color selection combinations.",
    "Out-of-stock scenario: Disabled 'ADD TO CART' button behavior.",
    "Mandatory selection validation: Attempting Add to Cart without choosing mandatory variants."
  ]
}
