{
  "flow_id": "flow_smartphones_purchase",
  "flow_name": "Smartphones & Mobile Devices Purchase Flow",
  "category": "Smartphones",
  "target_match_keywords": [
    "smartphone",
    "smartphones",
    "phone",
    "phones",
    "mobile",
    "mobiles",
    "handset",
    "handsets",
    "samsung",
    "galaxy",
    "iphone",
    "apple",
    "huawei",
    "s26",
    "s25",
    "ultra",
    "pro max"
  ],
  "catalog_entrypoint": "/eshop/devices/listing?category=mobileDevices&subCategory=cat1100063&catName=Smartphones&listVal=Smartphones&locale=EN",
  "cart_endpoint": "/eshop/checkout/cart",
  "automation_boundary": {
    "automated_scope": "Product Catalog -> Variant Configuration (Storage, Color, Payment Plan) -> ADD TO CART -> Shopping Cart Verification",
    "external_boundary": "Live Payment Gateway (Credit Card / OTP) and UAE PASS login require external real credentials and are documented as an external boundary."
  },
  "graph_edges": [
    {
      "from": "homepage",
      "to": "smartphones_catalog",
      "action": "navigate_catalog"
    },
    {
      "from": "smartphones_catalog",
      "to": "device_configuration",
      "action": "select_product_sku"
    },
    {
      "from": "device_configuration",
      "to": "variant_selected",
      "action": "select_storage_and_color"
    },
    {
      "from": "variant_selected",
      "to": "payment_plan_selected",
      "action": "select_payment_plan"
    },
    {
      "from": "payment_plan_selected",
      "to": "cart_checkout",
      "action": "click_add_to_cart"
    }
  ],
  "canonical_steps": [
    {
      "step_number": 1,
      "action": "Navigate to e& UAE portal homepage",
      "target": "/en/index.html",
      "expected_result": "e& UAE portal homepage loads successfully"
    },
    {
      "step_number": 2,
      "action": "Dismiss cookie and privacy overlay banner",
      "target": "#usercentrics-root",
      "expected_result": "Cookie overlay is dismissed cleanly"
    },
    {
      "step_number": 3,
      "action": "Navigate to Devices -> Smartphones catalog",
      "target": "/eshop/devices/listing?category=mobileDevices&subCategory=cat1100063&catName=Smartphones&listVal=Smartphones&locale=EN",
      "expected_result": "Smartphones catalog displays available models and pricing plans"
    },
    {
      "step_number": 4,
      "action": "Open product configuration for {{product_name}}",
      "target": "/eshop/devices/configuration?productId={{product_id}}&skuId={{sku_id}}&catName=Smartphones&listVal=Smartphones&showDefault=true",
      "expected_result": "Product configuration page loads with live storage, color swatches, and payment options"
    },
    {
      "step_number": 5,
      "action": "Select storage capacity and color variant",
      "target": ".device-variant-options, [role='radio'], button.variant-btn, .storage-btn, label:has-text('GB')",
      "expected_result": "Selected storage and color are highlighted and price updates"
    },
    {
      "step_number": 6,
      "action": "Select payment option (One Time or Smart Pay installment)",
      "target": ".segment-tab, [role='radio'], button:has-text('One time')",
      "expected_result": "Payment plan is selected"
    },
    {
      "step_number": 7,
      "action": "Detect stock state and Click 'ADD TO CART' / 'Checkout Now' button",
      "target": "button:has-text('Checkout Now'), button:has-text('ADD TO CART')",
      "expected_result": "If in-stock item is added to cart; if out-of-stock ADD TO CART is correctly disabled"
    },
    {
      "step_number": 8,
      "action": "Verify Shopping Cart & Secure Checkout review screen",
      "target": "/eshop/checkout/cart",
      "expected_result": "Shopping cart renders product summary with One Time or Installment details"
    }
  ],
