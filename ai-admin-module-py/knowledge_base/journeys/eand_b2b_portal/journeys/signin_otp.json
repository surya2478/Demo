  "conditional_branches": [
    {
      "branch_id": "OTP-B1",
      "at_step": 1,
      "condition": "identifier not associated with a customer",
      "outcome": "stay on SCR_LOGIN with 'No Customer assosiated'",
      "rule": "BR-AUTH-01"
    },
    {
      "branch_id": "OTP-B2",
      "at_step": 1,
      "condition": "wrong or expired OTP",
      "outcome": "SCR_OTP_ERROR_DIALOG -> step 5 -> back to step 4",
      "rule": "BR-AUTH-04"
    },
    {
      "branch_id": "OTP-B3",
      "at_step": 1,
      "condition": "OTP not received",
      "outcome": "click Resend; new OTP issued",
      "rule": "BR-AUTH-05"
    },
    {
      "branch_id": "OTP-B4",
      "at_step": 1,
      "condition": "no default organization",
      "outcome": "continue with flow_b2b_select_organization",
      "rule": "BR-AUTH-06"
    },
    {
      "branch_id": "OTP-B5",
      "at_step": 1,
      "condition": "default organization set",
      "outcome": "Organization Dashboard directly",
      "rule": "BR-AUTH-06"
    }
  ],
