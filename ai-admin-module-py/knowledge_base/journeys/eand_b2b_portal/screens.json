          "default_state": "selected",
          "used_by_journeys": [
            "B2B.REG.EXISTING.SIGNIN.OTP"
          ],
          "basis": "explicit",
          "locator_hint": "tab \"Sign in using OTP\"",
          "automation_ref": null,
          "aliases": [
            "otp tab"
          ]
        },
        {
