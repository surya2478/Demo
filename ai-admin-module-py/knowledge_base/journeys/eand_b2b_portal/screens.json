      "route_ref": "endpoints.otp_entry",
      "sources": [
        "Sign-in using OTP.pdf p1-2",
        "existing KB flow_b2b_login_otp"
      ],
      "functional_purpose": "Collects the 6-digit OTP sent to the user's registered e-mail and mobile, with masked destinations shown for confirmation and a resend option.",
      "elements": [
        {
          "element_id": "otp_heading",
          "label": "Enter your One Time Password.",
          "type": "heading",
          "basis": "explicit",
          "automation_ref": null
