          "type": "text",
          "basis": "explicit",
          "automation_ref": null
        },
        {
          "element_id": "masked_email",
          "label": "Email ID : p*********@e***.com",
          "type": "text",
          "format": "first char + asterisks + @ + first char + *** + TLD",
          "basis": "explicit",
          "automation_ref": null,
          "aliases": [
            "masked destinations",
            "masked email"
          ]
        },
        {
          "element_id": "masked_mobile",
          "label": "Mobile Number : 0******32",
          "type": "text",
          "format": "first digit + asterisks + last two digits",
          "basis": "explicit",
          "automation_ref": null
        },
        {
          "element_id": "otp_digit_1_6",
          "label": "OTP digit boxes (6)",
          "type": "otp_input_group",
          "mandatory": true,
          "format": "exactly 6 numeric digits, one per box",
          "basis": "explicit",
          "automation_ref": "selectors.authentication.otp_digit_field_all",
          "note": "'opt-field' is the application's own spelling.",
          "aliases": [
            "six-digit otp",
            "6-digit otp",
            "otp digits",
            "otp boxes",
            "digit boxes"
          ]
        },
        {
          "element_id": "otp_valid_tick",
          "label": "(green check icon)",
          "type": "status_icon",
          "basis": "explicit",
          "automation_ref": null,
          "note": "Shown after 6 digits are entered."
        },
        {
          "element_id": "resend",
          "label": "Resend",
          "type": "link",
          "context_text": "Didn't receive the OTP on your email?",
          "basis": "explicit",
          "locator_hint": "link \"Resend\"",
          "automation_ref": null
        },
        {
          "element_id": "proceed",
          "label": "Proceed",
          "type": "button",
          "basis": "explicit",
          "locator_hint": "button \"Proceed\"",
          "automation_ref": null,
          "note": "PDF text says 'Enter the OTP and click the Proceed button' but the p1 capture shows no button (it may render after the 6th digit, or verification may auto-submit as the existing KB assumes). The crawl must settle this.",
          "aliases": [
            "submit the code"
          ]
        }
      ],
      "transitions": [
        {
          "on": "proceed",
          "condition": "OTP correct and unexpired; user has a default organization",
          "to": "SCR_ORG_DASHBOARD",
          "rule": "BR-AUTH-06"
        },
        {
          "on": "proceed",
          "condition": "OTP correct; user has no default organization",
          "to": "SCR_SELECT_ORG",
          "rule": "BR-AUTH-06"
        },
        {
          "on": "proceed",
          "condition": "OTP wrong or expired",
          "to": "SCR_OTP_ERROR_DIALOG",
          "rule": "BR-AUTH-04"
        },
        {
          "on": "resend",
          "to": "SCR_OTP_ENTRY",
          "effect": "new OTP issued; previous OTP invalidated (inferred)",
          "rule": "BR-AUTH-05"
        }
      ],
      "aliases": [
        "otp panel",
        "otp screen",
        "one time password screen"
      ]
    },
