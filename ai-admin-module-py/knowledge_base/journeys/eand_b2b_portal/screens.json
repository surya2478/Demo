{
  "_purpose": "Screen catalogue (design): every distinct page/modal, its elements with their exact labels, and its transitions. Test cases quote labels from here verbatim. No locators live here -- `automation_ref` points into the Automation KB profile, and services/journeys/diff.py follows it.",
  "_fields": {
    "basis": "explicit = visible in a design document; qa_observed = known only from the Automation KB / QA recording; inferred = implied",
    "locator_hint": "role + accessible name the crawl should look for when capturing this element (Playwright getByRole form). Search guidance, never an execution target.",
    "automation_ref": "dotted path into the Automation KB app_profile.json (e.g. selectors.authentication.username_field). null = not yet captured by a crawl."
  },
  "_scope": "Screens of journeys B2B.REG.EXISTING.SIGNIN.OTP and B2B.REG.EXISTING.SIGNIN.SELECT_ORG. SCR_LOGIN also lists the password-tab and UAE PASS controls because they share the screen.",
  "screens": [
    {
      "screen_id": "SCR_LOGIN",
      "name": "Sign in to Business Online (Login)",
      "route": "/b2bportal/login.html?rdr=home&locale=en",
      "route_ref": "endpoints.login",
      "sources": [
        "Sign-in using OTP.pdf p1",
        "Sign-in using Password.pdf p1",
        "Sign-in using UAE Pass.pdf p1",
        "Registering on B2B Portal.pdf p1"
      ],
      "functional_purpose": "Single entry point for unauthenticated users. Offers three authentication methods (OTP tab, e& Password tab, UAE PASS) and a route to self-registration.",
      "layout_regions": [
        "Public header (Product, Solutions, Business App Store, Resources, My Account)",
        "Left: SIGN IN TO BUSINESS ONLINE panel with two tabs",
        "Right: BENEFITS OF OUR BUSINESS ONLINE ACCOUNT with REGISTER"
      ],
      "elements": [
        {
          "element_id": "tab_otp",
          "label": "Sign in using OTP",
