node_modules
.git
Dockerfile
.dockerignore

# --- Secrets: keep the developer's .env out of the build context -------------
# Vite INLINES every VITE_ variable into the public bundle at build time, so a
# .env that reaches the builder is published to every user of the site. This
# directory's .env carries a Solutions API host and a login password; without
# these lines `COPY . .` brought them in and `npm run build` compiled them into
# the JavaScript.
#
# .env.production is the exception: the Dockerfile writes it itself, after the
# COPY, to set VITE_API_URL from the build arg.
.env
.env.*
!.env.production
!.env.example

# Build output -- regenerated by npm run build inside the image.
dist
