# Frontend environment. Copy to .env and fill in for your environment.
#
# EVERY VITE_ VALUE BELOW IS COMPILED INTO THE PUBLIC JAVASCRIPT BUNDLE.
# Vite inlines them at build time, so anything here is readable by every user
# of the site and by anyone who downloads the bundle. Never put a password, an
# API key, or a token in this file or in .env -- there is no such thing as a
# private VITE_ value. Secrets belong in the backend's .env, which is read
# server-side and never shipped to a browser.

PORT=5175

# Where the browser sends API calls. In a container build this is supplied as
# the VITE_API_URL build arg instead -- see docker-compose.yml. It is frozen
# into the bundle, so a wrong value cannot be fixed without rebuilding.
VITE_API_URL=http://127.0.0.1:8002

VITE_PUBLIC_PATH=/

# Idle seconds before the session warning appears.
VITE_SNOOZE_SECONDS=1500

# Solutions API. Placeholder host -- set your own.
VITE_SOLUTION_API_BASE_URL=https://solutions.example.com/api
VITE_SSD_AUTH_LOGIN_URL=https://solutions.example.com/api/auth/login

# See the warning above: these two reach the browser in cleartext. Prefer
# leaving them empty and having users sign in themselves. If your deployment
# genuinely needs a shared account here, treat its password as public.
VITE_SSD_AUTH_LOGIN_EMAIL=
VITE_SSD_AUTH_LOGIN_PASSWORD=
