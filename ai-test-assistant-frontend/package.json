{
  "name": "ai-test-assistant-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "serve": "npm run build && npm run start",
    "pack:win": "npm run build && powershell -Command \"Compress-Archive -Path 'dist\\\\*' -DestinationPath 'dist.zip' -Force\"",
    "pack:linux": "npm run build && tar -czf dist.tar.gz -C dist ."
  },
  "dependencies": {
    "@types/prismjs": "^1.26.5",
    "@types/xlsx": "^0.0.35",
    "axios": "^1.4.0",
    "date-fns": "^4.1.0",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.5",
    "express": "^4.18.2",
    "mammoth": "^1.11.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-datepicker": "^8.8.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.6.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "baseline-browser-mapping": "^2.9.12",
    "postcss": "^8.4.35",
    "typescript": "^5.2.2",
    "vite": "^5.4.8"
  }
}
